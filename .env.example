# Copy to .env and fill with your Firebase project web app values (client-safe only).
# Restart Metro after changing.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# For EAS cloud builds (installable APK on your phone), copy these same keys into
# expo.dev → Project → Environment variables, or use: eas secret:create --name KEY --value "..."
